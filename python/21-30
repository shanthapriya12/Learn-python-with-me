    if letter.isalpha():
       word+=1
    elif letter.isdigit():
       digit+=1
    elif not letter.isalpha() and not letter.isdigit():
       special_symbol+=1
print(f"Letter:{word}\n Digit:{digit}\nSpecial characters:{special_symbol}")

28.password=input("Enter the password (atleast 8 characters):")
has_upper=False
has_lower=False
has_digit=False
for letter in password:
    if len(password)<8:
       print("Password should contain atleast 8 characters")
    elif letter.isupper():
       has_upper=True
    elif letter.islower():
       has_lower=True
    elif letter.isdigit():
       has_digit=True
if (
    len(password)>=8
    and has_upper
    and has_lower
    and has_digit
):
    print("Strong password")
else:
    print("Weak password")

