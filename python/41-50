44.student = {}
entry = int(input("How many students? "))
a_grade = 0
b_grade = 0
c_grade = 0
fail = 0
for stu in range(entry):
    name = input("Enter name: ")
    mark = int(input("Enter mark: "))
    student[name] = mark
for stu in student:
    if student[stu]>=90:
       a_grade +=1
