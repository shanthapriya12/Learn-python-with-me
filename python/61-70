62.def most_frequent(numbers):
      num_dict={}
      most_num=0
      most_fre=0
      for no in numbers:
        if no not in num_dict:
                num_dict[no]=1
        else: 
                num_dict[no]+=1
      for number in num_dict:
          if num_dict[number] >most_fre:
             most_fre=num_dict[number]
             most_num=number
      return most_num,most_fre
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   most_num,most_fre=most_frequent(numbers)
   print(f"Most frequent no with count: {most_num}:{most_fre}")

