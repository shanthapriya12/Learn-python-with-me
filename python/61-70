68.def count_even_odd(numbers):
     even=0
     odd=0
     for no in numbers:
        if no %2==0:
           even+=1
        else:
           odd+=1
     return even,odd
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   even,odd=count_even_odd(numbers)
   print(f"Even numbers: {even}\nOdd numbers: {odd}")


