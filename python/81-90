81.def double_numbers(numbers):
       new_list=[]
       mul_2=0
       for no in numbers:
          mul_2=no*2
          new_list.append(mul_2)
       return new_list
   numbers=[]
   entry = int(input("How many numbers? ")) 
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   new_list=double_numbers(numbers)
   print(f"The updated list :{new_list}") 


82.def count_divisible_by_2_and_3(numbers):
       count=0
       for no in numbers:
           if no%2==0 and no%3==0:
              count+=1          
       return count
   numbers=[]
   entry = int(input("How many numbers? ")) 
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   count=count_divisible_by_2_and_3(numbers)
   print(f"Count of numbers divisible by 2 and 3:{count}")


