79.def replace_negative(numbers):
    new_list = []
    for no in numbers:
        if no < 0:
            new_list.append(0)
        else:
            new_list.append(no)
    return new_list
numbers = []
entry = int(input("How many numbers? "))
for i in range(entry):
    num = int(input("Enter number: "))
    numbers.append(num)
new_list = replace_negative(numbers)
print(f"The updated list replaced with zero: {new_list}")


