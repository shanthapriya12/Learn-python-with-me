98.def average_positive(numbers):
       sum=0
       count=0
       for no in numbers:
           if no>0:
              sum+=no
              count+=1
       
       if count>0:
          return sum/count
       return None
   numbers=[]
   entry=int(input("How many students ?"))
   for i in range(entry):
       num=int(input("Enter the number:"))
       numbers.append(num)
   avg=average_positive(numbers)
   print(f"Average of positive numbers:{avg}")


99.def average_negative(numbers):
       sum=0
       count=0
       for no in numbers:
           if no<0:
              sum+=no
              count+=1
       
       if count>0:
          return sum/count
       return None
   numbers=[]
   entry=int(input("How many students ?"))
   for i in range(entry):
       num=int(input("Enter the number:"))
       numbers.append(num)
   avg=average_negative(numbers)
   print(f"Average of negative numbers:{avg}")

100.def count_positive_and_negative(numbers):
        count_pos=0
        count_neg=0
        for no in numbers:
           if no>0:
              count_pos+=1
           elif no<0:
              count_neg+=1
        return count_pos,count_neg
   numbers=[]
   entry=int(input("How many students ?"))
   for i in range(entry):
       num=int(input("Enter the number:"))
       numbers.append(num)
   count_pos,count_neg=count_positive_and_negative(numbers)
   print(f"Count of positive number:{count_pos}\n Count of negative number:{count_neg}")




