91.def largest_negative(numbers):
       large=None
       for no in numbers:
           if no<0:
              if large is None or large<no:
                 large=no
       return large
   numbers=[]
   entry = int(input("How many numbers? ")) 
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   large=largest_negative(numbers)
   print(f"largest negative number in list :{large}")


