96.def absolute_values(numbers):
       new_list=[]
       for no in numbers:
           if no>0:
              new_list.append(no)
           else:
              new_list.append(no*(-1))
       return new_list
   numbers=[]
   entry = int(input("How many numbers? ")) 
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   new_list=absolute_values(numbers)
   print(f"The updated list:{new_list}")

