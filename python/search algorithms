sa10.def is_anagram(text1, text2):
      if len(text1) != len(text2):
        return False
      for letter in text1:
        count1 = 0
        count2 = 0
        for ch in text1:
          if ch == letter:
            count1 += 1
        for ch in text2:
          if ch == letter:
            count2 += 1
        if count1 != count2:
