sa6.def insertion_sort(numbers):
     for i in range(1,len(numbers)):
        key = numbers[i]
        j = i - 1
        while j >= 0 and numbers[j] > key:
           numbers[j + 1] = numbers[j]
           j -= 1
        numbers[j + 1] = key    
      return numbers
    numbers=[]
    entry = int(input("How many numbers? "))
    for i in range(entry):
      num = int(input("Enter number: "))
      numbers.append(num)
    result=insertion_sort(numbers)
    print("The updated list using insertion sort:{result}")

