sa13.def word_frequency(text):
         words = text.split()
         frequency = {}

         for word in words:
           if word in frequency:
            frequency[word] += 1
           else:
            frequency[word] = 1

         return frequency


     text = input("Enter a sentence: ")
     result = word_frequency(text)

     print("Word Frequency:")
     for word, count in result.items():
        print(word, ":", count) 
     
