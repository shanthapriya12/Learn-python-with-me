        i=0
        j=0
        while i<len(list1) and j<len(list2):
        if list1[i] <= list2[j]:
            updated.append(list1[i])
            i += 1
        else:
            updated.append(list2[j])
            j += 1

        while i < len(list1):
            updated.append(list1[i])
            i += 1

        while j < len(list2):
            updated.append(list2[j])
            j += 1   
               
        return updated
    list1=[]
    list2=[]
    entry = int(input("How many numbers in list1? "))
