s20.def longest_word(text):
    current_word = ""
    longest = ""
    for letter in text:
        if letter != " ":
            current_word+=letter
        else:
            if len(current_word) > len(longest):
                longest = current_word
            current_word = ""
    if len(current_word) > len(longest):
        longest = current_word
    return longest

text = input("Enter a string: ")
result = longest_word(text)
print(f"The longest word is: {result}")


s20.def shortest_word(text):
    current_word = ""
    shortest = None
    for letter in text:
        if letter != " ":
            current_word+=letter
        else:
            if shortest is None or len(current_word) < len(shortest)  :
                shortest = current_word
            current_word = ""
    if shortest is None or len(current_word) < len(shortest) :
        shortest = current_word
    return shortest

text = input("Enter a string: ")
result = shortest_word(text)
print(f"The shortest word is: {result}")



