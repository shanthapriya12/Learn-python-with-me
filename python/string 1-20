        uppercase="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        for letter in text:
            if letter in lowercase:
               letter1=ord(letter)
               letter2=letter1-32
               final+=chr(letter2)
            elif letter in uppercase:
               letter1=ord(letter)
               letter2=letter1+32
               final+=chr(letter2)
            else:
               final+=letter
        return final
    text=input("Enter a string:")
    final=toggle_case(text)
    print(f"The toggled string is:{final}")
 
