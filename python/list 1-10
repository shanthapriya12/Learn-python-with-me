l4.def second_largest(numbers):
     long=numbers[0]
     sec_long=numbers[0]
     for no in numbers:
         if no>long:
            sec_long=long
            long=no
         elif sec_long<no<long:
            sec_long=no
     return sec_long
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   sec_long=second_largest(numbers)
   print(f"Second largest number:{sec_long}")

l5.def second_smallest(numbers):
     small=numbers[0]
     sec_small=numbers[0]
     for no in numbers:
         if no<small:
            sec_small=small
            small=no
         elif sec_small>no>small:
            sec_small=no
     return sec_small
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   sec_small=second_smallest(numbers)
   print(f"Second smallest number:{sec_small}")

l6.def count_even_odd(numbers):
       count_even=0
       count_odd=0
       for no in numbers:
           if no%2==0:
              count_even+=1
           elif no%2!=0:
              count_odd+=1
       return count_even,count_odd
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   count_even,count_odd=count_even_odd(numbers)
   print(f"Count of even number in the list:{count_even}\n Count of odd number in the list:{count_odd}")

l7.def reverse_list(numbers):
       reverse=[]
       for i in range(len(numbers) - 1, -1, -1):
           reverse.append(numbers[i])
       return reverse
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   reverse=reverse_list(numbers)
   print(f"Reversed list:{reverse}")

