l5.def second_smallest(numbers):
     small=numbers[0]
     sec_small=numbers[0]
     for no in numbers:
         if no<small:
            sec_small=small
            small=no
         elif sec_small>no>small:
            sec_small=no
     return sec_small
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   sec_small=second_smallest(numbers)
   print(f"Second smallest number:{sec_small}")

l6.def count_even_odd(numbers):
       count_even=0
       count_odd=0
       for no in numbers:
           if no%2==0:
              count_even+=1
           elif no%2!=0:
              count_odd+=1
       return count_even,count_odd
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   count_even,count_odd=count_even_odd(numbers)
   print(f"Count of even number in the list:{count_even}\n Count of odd number in the list:{count_odd}")

