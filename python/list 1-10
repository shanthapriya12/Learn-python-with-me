l14.def rotate_right(numbers):
        rotate_right=[]
        rotate_right.append(numbers[-1])
        if numbers[-1] in rotate_right:
            for no in range(len(numbers) - 1):
                rotate_right.append(numbers[no])
        return rotate_right

    numbers=[]
    entry = int(input("How many numbers in list1? "))
    for i in range(entry):
      num = int(input("Enter number: "))
      numbers.append(num)
    rotate_right=rotate_right(numbers)
    print(f"The updated list:{rotate_right}") 

