58.def count_numbers(numbers):
     positive=0
     negative=0
     zero=0 
     for no in numbers:
        if no>0:
           positive+=1
        elif no<0:
           negative+=1
        else:
           zero+=1
     return positive,negative,zero
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   positive,negative,zero=count_numbers(numbers)
   print(f"Positive numbers: {positive}\nNegative numbers: {negative}\nZeroes: {zero}")
   
59.def second_largest(numbers):
     long=0
     sec_long=0
     for no in numbers:
         if no>long:
            sec_long=long
            long=no
         elif sec_long<no<long:
            sec_long=no
     return sec_long
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   sec_long=second_largest(numbers)
   print(f"Second largest number:{sec_long}")
          
60.def remove_duplicates(numbers):
     unique=[]
     for no in numbers:
       if no not in unique:
          unique.append(no)
     return unique
   numbers=[]
   entry = int(input("How many numbers? "))
   for i in range(entry):
     num = int(input("Enter number: "))
     numbers.append(num)
   result=remove_duplicates(numbers)
   print(f"Without duplicate values:{result}")


